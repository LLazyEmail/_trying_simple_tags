{
  "name": "atherdon-newsletter-js-layouts-typography",
  "version": "4.0.2",
  "description": "im trying to separate part of our code",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "browser": "dist/index.iife.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/index.iife.js",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "default": "./dist/index.es.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bundle": "tsup",
    "dev": "tsup --watch",
    "build": "npm run clean && npm run bundle",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "vitest run tests/visual-review.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "shx rm -rf ./coverage && shx rm -rf ./dist",
    "lint:prettier": "prettier --write src/",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-json": "^5.0.0",
    "globals": "^17.12.0",
    "prettier": "3.9.8",
    "shx": "0.4.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "author": "Arthur Tkachenko",
  "license": "MIT",
  "private": false,
  "release": {
    "publishDir": "dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "fsevents": "*"
  },
  "dependencies": {
    "lit-typography": "^0.1.0",
    "stringify-attributes": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LLazyEmail/_trying_simple_tags"
  }
}
